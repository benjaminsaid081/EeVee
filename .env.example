# Copia este archivo como ".env" y rellena tus claves.
# EV también permite configurarlas desde la interfaz (engranaje > Ajustes).

# --- Inteligencia (elige una; en Ajustes también se puede cambiar) ---
# openai | gemini | gemini-live | anthropic | compatible
EV_AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Solo para "compatible" (OpenRouter, Groq, DeepSeek, Ollama...)
EV_COMPATIBLE_BASE_URL=
EV_COMPATIBLE_KEY=

# --- Voz (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Voz gratis (Microsoft Edge, sin clave) ---
# auto = ElevenLabs si hay clave y funciona; si no, Edge
EV_TTS_PROVIDER=auto
EV_EDGE_VOICE=es-ES-ElviraNeural

# --- Voz de Gemini (usa GEMINI_API_KEY) ---
GEMINI_VOICE=Kore
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Visión de pantalla ---
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# 0 desactiva los clics/teclado automáticos
EV_ALLOW_SCREEN_CONTROL=1

# Silencio inicial antes de cada frase (ms). Súbelo si tu altavoz corta el inicio.
EV_TTS_LEAD_MS=400

# --- Oído (Whisper local, gratis y privado) ---
# auto = local primero; local = solo local; openai = solo API de OpenAI
EV_STT_PROVIDER=auto
EV_STT_MODEL=onnx-community/whisper-small

# --- Spotify (opcional: para búsqueda con API oficial; sin claves usa comandos de Windows) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Google Calendar (opcional: OAuth para agendar y consultar eventos) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Servidor ---
EV_PORT=4173
